# #linear time=o(n)

n=100
for i in range(n):
    print(i,end=" ")

# #quadratic=o(n^2)

num=5
for i in range(1,num+1):
    for j in range(1,num+1):
        print(j,end=" ")
    print() 

# #logarithmic o(log n)

nums=16
while nums>1:
    print(nums)
    nums//=2